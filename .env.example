# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Secrets are read ONLY from the environment or a local .env — never from code,
# never committed, never uploaded to a worker. See docs/security.md.

# --- Repo source for disposable cloud workers ---------------------------------
# Workers `git clone` this and `git checkout` an exact SHA. Use a read-only URL.
GUARDIAN_REPO_URL=https://github.com/yourname/guardian-research.git

# --- Budget overrides (can only TIGHTEN the pyproject [tool.guardian] caps) ----
# GUARDIAN_MAX_JOB_COST_USD=5
# GUARDIAN_MAX_DAILY_COST_USD=25

# --- Real cloud launches (default: DISABLED) ----------------------------------
# Both of these must be true for `ga launch --yes` to actually submit a job:
#   1) install the cloud extra:  uv sync --extra cloud
#   2) opt in explicitly:
# GUARDIAN_ALLOW_REAL_LAUNCH=1

# --- Cloud provider credentials (used by SkyPilot; keep secret) ---------------
# RUNPOD_API_KEY=
# LAMBDA_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Tracking (local/self-hosted by default) ----------------------------------
# MLFLOW_TRACKING_URI=file:./mlruns

# --- Object store for worker result upload + local collect --------------------
# GCS (recommended):
# GUARDIAN_ARTIFACT_URI=gs://your-bucket/guardian-runs
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# S3 (alternative):
# GUARDIAN_ARTIFACT_URI=s3://your-bucket/guardian-runs
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Persona data class gate (private persona data is OFF by default) ----------
# Leave false unless an encryption plan + approval gate exist (see docs/security.md).
# GUARDIAN_ALLOW_PRIVATE_PERSONA_DATA=false
